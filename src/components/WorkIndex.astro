---
import FileCard from './FileCard.astro';
import FileRow from './FileRow.astro';
import { works } from '../data/works';
const tabs = [
  { f: 'ALL', label: 'All' }, { f: 'MOV', label: 'Mov' }, { f: 'IDN', label: 'Idn' }, { f: 'WEB', label: 'Web' },
];
const count = (f: string) => (f === 'ALL' ? works.length : works.filter((w) => w.type === f).length);
---
<section class="index" aria-label="작업 목록" data-index>
  <div class="toolbar label">
    <div class="tabs" role="group" aria-label="분야 필터">
      {tabs.map((t, i) => (
        <button type="button" data-f={t.f} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label}<span class="n">{count(t.f)}</span></button>
      ))}
    </div>
    <div class="views" role="group" aria-label="보기 방식">
      <button type="button" data-v="grid" aria-pressed="true" aria-label="그리드 보기">▦<span class="txt"> Grid</span></button>
      <button type="button" data-v="list" aria-pressed="false" aria-label="목록 보기">☰<span class="txt"> List</span></button>
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-status></p>
  <ul class="grid label" data-grid>{works.map((w, i) => <FileCard work={w} eager={i < 4} />)}</ul>
  <ul class="list label" data-list hidden>{works.map((w) => <FileRow work={w} />)}</ul>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-index]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-f]')];
    const views = [...root.querySelectorAll<HTMLButtonElement>('[data-v]')];
    const apply = (f: string) => {
      tabs.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
      let n = 0;
      root.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => {
        const show = f === 'ALL' || el.dataset.type === f;
        el.hidden = !show;
        if (show && el.closest('[data-grid]')) n++;
      });
      status.textContent = `${n} items`;
    };
    tabs.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.f!;
      apply(f);
      history.replaceState(null, '', f === 'ALL' ? location.pathname : `#${f.toLowerCase()}`);
    }));
    views.forEach((b) => b.addEventListener('click', () => {
      views.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const g = b.dataset.v === 'grid';
      grid.hidden = !g; list.hidden = g;
    }));
    const fromHash = location.hash.slice(1).toUpperCase();
    if (['MOV', 'IDN', 'WEB'].includes(fromHash)) apply(fromHash);
  }
</script>

<style>
  .toolbar { position: sticky; top: calc(env(safe-area-inset-top, 0px) + var(--tap) + 1px); z-index: 5; background: var(--color-paper); display: flex; justify-content: space-between; border-block: var(--border); }
  .tabs, .views { display: flex; }
  button { min-height: var(--tap); min-width: var(--tap); padding-inline: var(--space-3); border-right: var(--border-soft); }
  .views button { border-right: 0; border-left: var(--border-soft); }
  button:hover, button[aria-pressed="true"] { background: var(--color-ink); color: var(--color-paper); }
  .n { color: var(--color-mute); margin-left: var(--space-1); }
  button[aria-pressed="true"] .n, button:hover .n { color: var(--color-disabled); }
  .n { display: none; }
  button[aria-pressed="true"] .n { display: inline; }
  @media (min-width: 768px) { .n { display: inline; } }
  @media (max-width: 767px) { .txt { display: none; } }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--color-line); border-bottom: var(--border-soft); }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .list { list-style: none; margin: 0; padding: 0; }
</style>
